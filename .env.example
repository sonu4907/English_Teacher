# Optional server-wide Gemini key. Individual signed-in users may save an encrypted key.
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Authentication is disabled in local development when DATABASE_URL is unset.
# Production refuses to start unless all authentication/email secrets are configured.
# Render deployments automatically use RENDER_EXTERNAL_URL if APP_BASE_URL is not set.
DATABASE_URL=postgresql://verba_user:change-me@localhost:5432/verbaai
APP_BASE_URL=https://your-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=VerbaAI <no-reply@your-domain.example>

# Generate unique values; never commit real secrets.
# SESSION_SECRET: at least 32 random bytes.
# DATA_ENCRYPTION_KEY: base64-encoded 32 random bytes (used for saved Gemini keys and TOTP secrets).
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
